# ==============================================================================
# Institute Portal - Global Git Ignore
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment Variables & Secrets (Keep example templates)
.env
.env*.local
.env.production
.env.staging
.env.backup*
*.env.bak*
!.env.example
!.env.*.example

# Node / Frontend Build & Dependencies
node_modules/
/frontend/node_modules/
.npm/
.eslintcache
.stylelintcache
*.tsbuildinfo
next-env.d.ts.bak

# Next.js Build Artifacts
.next/
/frontend/.next/
out/
/frontend/out/
build/
/frontend/build/
dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Go Binaries & Build Output
bin/
/backend/bin/
backend/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
cover.out
coverage/

# Docker Local Mounts & Volumes
pgdata/
redisdata/
docker-volumes/

# Archives & Temporary Backups
*.tar
*.tar.gz
*.zip
*.rar
*.7z
tempcsebase/
*.bak
*.tmp
*.swp
*.swo

# IDE & Editor Settings
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
